{
  "name": "kytew",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @kytew/api\" \"npm run dev -w @kytew/desktop\"",
    "desktop": "npm run desktop -w @kytew/desktop",
    "voice:setup": "node infra/setup-voice.cjs",
    "build": "npm run build -w @kytew/api && npm run build -w @kytew/desktop",
    "typecheck": "npm run typecheck --workspaces",
    "db:generate": "npm run db:generate -w @kytew/api",
    "db:migrate": "npm run db:migrate -w @kytew/api",
    "test": "npm run test -w @kytew/api",
    "test:ui": "playwright test",
    "dist:win": "npm run build -w @kytew/desktop && npm run dist:win -w @kytew/desktop"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "multer": "2.5.0",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.4"
    }
  }
}
