# Copy to .env in repository root. Never commit real credentials.
DATABASE_URL=postgresql://kytew:kytew_local_only@localhost:5432/kytew?schema=public
REDIS_URL=redis://localhost:6379
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Optional extra exact origins, comma-separated (no wildcard or URL paths).
# WEB_ORIGINS=http://192.168.1.50:5173,http://my-pc.local:5173
# In development, this PC's private IPv4 addresses on the WEB_ORIGIN port
# are trusted automatically for tablets/phones. Set false to disable.
ALLOW_LAN_ORIGINS=true
NODE_ENV=development
# Electron loads a trusted web origin. HTTPS is required outside localhost.
KYTEW_APP_URL=http://localhost:5173
# Future media/storage integrations (not implemented in v0.1):
# LIVEKIT_URL=wss://your-livekit-host
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
