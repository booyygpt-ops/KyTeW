# Copy to .env in repository root. Never commit real credentials.
DATABASE_URL=postgresql://kytew:kytew_local_only@localhost:5432/kytew?schema=public
REDIS_URL=redis://localhost:6379
PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
# Electron loads a trusted web origin. HTTPS is required outside localhost.
KYTEW_APP_URL=http://localhost:5173
